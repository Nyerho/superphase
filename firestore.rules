rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function systemAdminIdentity() {
      return signedIn()
        && request.auth.uid == 'z3KAMbKcGFNYVWH2OKHtz4AT1rs2'
        && request.auth.token.get('email', '') == 'admin@vertixtrades.com';
    }

    function isAdmin() {
      return (verified() && request.auth.token.get('admin', false) == true || systemAdminIdentity())
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email == request.auth.token.get('email', '');
    }

    function owns(uid) {
      return verified() && request.auth.uid == uid;
    }

    function validCurrency(value) {
      return value is string && value.matches('^[A-Z]{3}$');
    }

    function accountCurrency(uid, value) {
      return validCurrency(value)
        && get(/databases/$(database)/documents/users/$(uid)).data.preferredCurrency == value;
    }

    function activeMarket(marketId, symbol) {
      let marketPath = /databases/$(database)/documents/marketAssets/$(marketId);
      return marketId is string
        && marketId.matches('^[A-Z0-9][A-Z0-9._:-]{0,39}$')
        && ((exists(marketPath)
          && get(marketPath).data.active == true
          && get(marketPath).data.symbol == symbol)
          || (marketId == symbol && marketId in ['BTCUSDT', 'ETHUSDT', 'SOLUSDT', 'AAPL', 'NVDA', 'TSLA', 'XAUUSD']));
    }

    function validMarketAsset(data) {
      return data.keys().hasAll(['displayName', 'symbol', 'assetType', 'active'])
        && data.keys().hasOnly(['displayName', 'symbol', 'assetType', 'tradingViewSymbol', 'active', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.symbol is string
        && data.symbol.matches('^[A-Z0-9][A-Z0-9._:-]{0,39}$')
        && data.assetType in ['crypto', 'stocks', 'forex', 'indices', 'commodities', 'other']
        && data.active is bool
        && (!('tradingViewSymbol' in data)
          || data.tradingViewSymbol == ''
          || (data.tradingViewSymbol is string && data.tradingViewSymbol.matches('^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$')));
    }

    function requestMatchesAfter(uid, requestId, requestType, requestStatus, recordCollection) {
      let requestPath = /databases/$(database)/documents/users/$(uid)/requests/$(requestId);
      let recordPath = /databases/$(database)/documents/users/$(uid)/$(recordCollection)/$(requestId);
      return existsAfter(requestPath)
        && getAfter(requestPath).data.uid == uid
        && getAfter(requestPath).data.type == requestType
        && getAfter(requestPath).data.status == requestStatus
        && getAfter(requestPath).data.resultId == requestId
        && existsAfter(recordPath)
        && getAfter(recordPath).data.uid == uid
        && getAfter(recordPath).data.requestId == requestId;
    }

    function balanceBeforeMatches(uid, amount, currency) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      let profile = get(profilePath).data;
      return exists(profilePath)
        && profile.preferredCurrency == currency
        && ((!('balance' in profile) && amount == 0) || (('balance' in profile) && profile.balance == amount))
        && (amount == 0 || !('balanceCurrency' in profile) || profile.balanceCurrency == currency);
    }

    function depositAmountAllowed(amount) {
      let settingsPath = /databases/$(database)/documents/platformSettings/global;
      return !exists(settingsPath)
        || (amount >= get(settingsPath).data.get('depositMin', 0.01)
          && (get(settingsPath).data.get('depositMax', 0) <= 0 || amount <= get(settingsPath).data.get('depositMax', 0)));
    }

    function withdrawalAmountAllowed(amount) {
      let settingsPath = /databases/$(database)/documents/platformSettings/global;
      return !exists(settingsPath)
        || (amount >= get(settingsPath).data.get('withdrawalMin', 0.01)
          && (get(settingsPath).data.get('withdrawalMax', 0) <= 0 || amount <= get(settingsPath).data.get('withdrawalMax', 0)));
    }

    match /users/{uid} {
      allow get: if owns(uid) || isAdmin() || systemAdminIdentity();
      allow list: if isAdmin() || systemAdminIdentity();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'legalName', 'dateOfBirth', 'phoneNumber',
          'countryOfResidence', 'addressLine1', 'city', 'postalCode',
          'preferredCurrency', 'employmentStatus', 'sourceOfFunds',
          'tradingExperience', 'accountPurpose', 'accountStatus', 'kycStatus',
          'referralCode', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'legalName', 'dateOfBirth', 'phoneNumber',
          'countryOfResidence', 'nationality', 'addressLine1', 'addressLine2',
          'city', 'region', 'postalCode', 'preferredCurrency', 'employmentStatus',
          'sourceOfFunds', 'tradingExperience', 'accountPurpose', 'accountStatus',
          'kycStatus', 'referralCode', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.legalName is string
        && request.resource.data.legalName.size() >= 2
        && request.resource.data.legalName.size() <= 120
        && request.resource.data.dateOfBirth is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.countryOfResidence is string
        && request.resource.data.addressLine1 is string
        && request.resource.data.city is string
        && request.resource.data.postalCode is string
        && validCurrency(request.resource.data.preferredCurrency)
        && request.resource.data.employmentStatus in ['employed', 'self_employed', 'student', 'retired', 'unemployed', 'other']
        && request.resource.data.sourceOfFunds in ['employment_income', 'business_income', 'savings', 'investment_income', 'pension', 'other']
        && request.resource.data.tradingExperience in ['none', 'under_1_year', '1_to_3_years', '3_to_5_years', 'over_5_years']
        && request.resource.data.accountPurpose in ['active_trading', 'investing', 'hedging', 'research', 'other']
        && request.resource.data.accountStatus == 'pending_verification'
        && request.resource.data.kycStatus == 'not_started';
      allow update: if isAdmin() || (owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'preferredCurrency', 'phoneNumber', 'addressLine1', 'addressLine2',
          'city', 'region', 'postalCode', 'updatedAt'
        ])
        && validCurrency(request.resource.data.preferredCurrency)
        && (request.resource.data.preferredCurrency == resource.data.preferredCurrency
          || !('balance' in resource.data)
          || resource.data.balance == 0))
        || (signedIn()
          && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && resource.data.accountStatus == 'pending_verification'
          && request.resource.data.accountStatus == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountStatus', 'emailVerifiedAt', 'updatedAt']))
        || (owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'balanceCurrency', 'balanceUpdatedAt', 'updatedAt'])
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.balance <= resource.data.get('balance', 0)
          && request.resource.data.balanceCurrency == request.resource.data.preferredCurrency);
      allow delete: if false;

      match /requests/{requestId} {
        allow read: if owns(uid) || isAdmin() || systemAdminIdentity();
        allow create: if owns(uid)
          && request.resource.data.uid == uid
          && request.resource.data.status == 'submitted'
          && request.resource.data.type in ['trade', 'deposit', 'withdrawal', 'loan', 'plan', 'support']
          && request.resource.data.keys().hasOnly([
            'uid', 'type', 'status', 'amount', 'currency', 'marketId', 'symbol', 'side',
            'leverage', 'duration', 'takeProfit', 'stopLoss', 'method',
            'destination', 'purpose', 'message', 'subject', 'planId', 'createdAt'
          ])
          && (!('amount' in request.resource.data) || (request.resource.data.amount is number && request.resource.data.amount >= 0))
          && (request.resource.data.type in ['support', 'plan'] || (request.resource.data.amount is number && request.resource.data.amount > 0))
          && (request.resource.data.type in ['trade', 'deposit', 'withdrawal', 'loan']
            ? accountCurrency(uid, request.resource.data.currency)
            : (!('currency' in request.resource.data) || accountCurrency(uid, request.resource.data.currency)))
          && (request.resource.data.type != 'deposit' || request.resource.data.get('method', '') in ['bank_transfer', 'digital_asset', 'card_payment'])
          && (request.resource.data.type != 'deposit' || depositAmountAllowed(request.resource.data.amount))
          && (request.resource.data.type != 'withdrawal' || withdrawalAmountAllowed(request.resource.data.amount))
          && (request.resource.data.type != 'withdrawal' || (request.resource.data.get('destination', '') is string && request.resource.data.get('destination', '').size() >= 1 && request.resource.data.get('destination', '').size() <= 100))
          && (request.resource.data.type != 'loan' || request.resource.data.get('purpose', '') in ['business', 'personal', 'other'])
          && (request.resource.data.type != 'trade' || (
            request.resource.data.keys().hasAll(['symbol', 'marketId', 'side', 'leverage'])
            && request.resource.data.symbol is string
            && request.resource.data.marketId is string
            && activeMarket(request.resource.data.marketId, request.resource.data.symbol)
            && request.resource.data.side in ['buy', 'sell']
            && request.resource.data.leverage is number
            && request.resource.data.leverage >= 1
            && request.resource.data.leverage <= 10
          ));
        allow update: if isAdmin()
          && request.resource.data.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'resultId', 'processedAt'])
          && (
            (request.resource.data.status in ['processing', 'reviewed', 'rejected']
              && !('resultId' in resource.data)
              && !('resultId' in request.resource.data))
            || (request.resource.data.status == 'accepted'
              && requestMatchesAfter(uid, requestId, 'trade', 'accepted', 'trades'))
            || (request.resource.data.status == 'completed'
              && request.resource.data.type in ['deposit', 'withdrawal']
              && requestMatchesAfter(uid, requestId, request.resource.data.type, 'completed', 'transactions'))
          );
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read: if owns(uid) || isAdmin() || systemAdminIdentity();
        allow create: if isAdmin()
          && transactionId == request.resource.data.requestId
          && request.resource.data.keys().hasAll(['uid', 'requestId', 'type', 'amount', 'currency', 'status', 'balanceBefore', 'balanceAfter', 'completedAt', 'createdAt', 'processedBy'])
          && request.resource.data.keys().hasOnly(['uid', 'requestId', 'type', 'amount', 'currency', 'status', 'method', 'destination', 'balanceBefore', 'balanceAfter', 'completedAt', 'createdAt', 'processedBy', 'manual'])
          && request.resource.data.uid == uid
          && request.resource.data.type in ['deposit', 'withdrawal']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && accountCurrency(uid, request.resource.data.currency)
          && request.resource.data.status == 'completed'
          && request.resource.data.balanceBefore is number
          && request.resource.data.balanceAfter is number
          && request.resource.data.balanceAfter >= 0
          && request.resource.data.completedAt is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.processedBy is string
          && (requestMatchesAfter(uid, transactionId, request.resource.data.type, 'completed', 'transactions')
            || (request.resource.data.manual == true && request.resource.data.processedBy == 'admin-manual'))
          && balanceBeforeMatches(uid, request.resource.data.balanceBefore, request.resource.data.currency)
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.balance == request.resource.data.balanceAfter
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.balanceCurrency == request.resource.data.currency
          && ((request.resource.data.type == 'deposit'
              && (request.resource.data.get('method', '') in ['bank_transfer', 'digital_asset', 'card_payment']
                || (request.resource.data.manual == true && request.resource.data.get('method', '') == 'manual'))
              && request.resource.data.balanceAfter == request.resource.data.balanceBefore + request.resource.data.amount)
            || (request.resource.data.type == 'withdrawal'
              && request.resource.data.get('destination', '') is string
              && request.resource.data.get('destination', '').size() > 0
              && request.resource.data.balanceBefore >= request.resource.data.amount
              && request.resource.data.balanceAfter == request.resource.data.balanceBefore - request.resource.data.amount));
        allow update, delete: if false;
      }

      match /trades/{tradeId} {
        allow read: if owns(uid) || isAdmin() || systemAdminIdentity();
      allow create: if isAdmin()
          && tradeId == request.resource.data.requestId
          && request.resource.data.keys().hasAll(['uid', 'requestId', 'marketId', 'type', 'symbol', 'side', 'amount', 'currency', 'leverage', 'entryPrice', 'status', 'openedAt', 'createdAt', 'processedBy'])
          && request.resource.data.keys().hasOnly(['uid', 'requestId', 'marketId', 'type', 'symbol', 'side', 'amount', 'currency', 'leverage', 'duration', 'entryPrice', 'takeProfit', 'stopLoss', 'status', 'openedAt', 'createdAt', 'processedBy', 'manual'])
          && request.resource.data.uid == uid
          && request.resource.data.type == 'trade'
          && request.resource.data.marketId is string
          && request.resource.data.symbol is string
          && activeMarket(request.resource.data.marketId, request.resource.data.symbol)
          && request.resource.data.side in ['buy', 'sell']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && accountCurrency(uid, request.resource.data.currency)
          && request.resource.data.leverage is number
          && request.resource.data.leverage >= 1
          && request.resource.data.leverage <= 10
          && request.resource.data.entryPrice is number
          && request.resource.data.entryPrice > 0
          && request.resource.data.status == 'open'
          && request.resource.data.openedAt is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.processedBy is string
          && ((requestMatchesAfter(uid, tradeId, 'trade', 'accepted', 'trades')
            && getAfter(/databases/$(database)/documents/users/$(uid)/requests/$(tradeId)).data.marketId == request.resource.data.marketId
            && getAfter(/databases/$(database)/documents/users/$(uid)/requests/$(tradeId)).data.symbol == request.resource.data.symbol
            && getAfter(/databases/$(database)/documents/users/$(uid)/requests/$(tradeId)).data.side == request.resource.data.side
            && getAfter(/databases/$(database)/documents/users/$(uid)/requests/$(tradeId)).data.amount == request.resource.data.amount
            && getAfter(/databases/$(database)/documents/users/$(uid)/requests/$(tradeId)).data.currency == request.resource.data.currency
            && getAfter(/databases/$(database)/documents/users/$(uid)/requests/$(tradeId)).data.leverage == request.resource.data.leverage)
            || (request.resource.data.manual == true && request.resource.data.processedBy == 'admin-manual'));
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll(['uid', 'requestId', 'marketId', 'type', 'symbol', 'side', 'amount', 'currency', 'leverage', 'entryPrice', 'status', 'openedAt', 'createdAt', 'processedBy'])
        && request.resource.data.keys().hasOnly(['uid', 'requestId', 'marketId', 'type', 'symbol', 'side', 'amount', 'currency', 'leverage', 'duration', 'entryPrice', 'takeProfit', 'stopLoss', 'status', 'openedAt', 'createdAt', 'processedBy', 'manual'])
        && request.resource.data.uid == uid
        && request.resource.data.requestId == tradeId
        && request.resource.data.type == 'trade'
        && request.resource.data.marketId is string
        && request.resource.data.symbol is string
        && activeMarket(request.resource.data.marketId, request.resource.data.symbol)
        && request.resource.data.side in ['buy', 'sell']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && accountCurrency(uid, request.resource.data.currency)
        && request.resource.data.leverage is number
        && request.resource.data.leverage >= 1
        && request.resource.data.leverage <= 10
        && request.resource.data.entryPrice is number
        && request.resource.data.entryPrice > 0
        && request.resource.data.status == 'open'
        && request.resource.data.openedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.processedBy == 'member-balance'
        && get(/databases/$(database)/documents/users/$(uid)).data.balance is number
        && get(/databases/$(database)/documents/users/$(uid)).data.balance >= request.resource.data.amount
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.balance == get(/databases/$(database)/documents/users/$(uid)).data.balance - request.resource.data.amount
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.balanceCurrency == request.resource.data.currency;
        allow update, delete: if false;
      }

      match /settings/{settingId} {
        allow read: if owns(uid) || isAdmin() || systemAdminIdentity();
        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly(['reduceMotion', 'updatedAt']);
        allow delete: if false;
      }

      match /{subcollection}/{documentId} {
        allow read: if owns(uid) || isAdmin() || systemAdminIdentity();
        allow write: if isAdmin() && !(subcollection in ['requests', 'trades', 'transactions', 'settings']);
      }
    }

    match /admins/{uid} {
      allow get: if isAdmin() || (systemAdminIdentity() && uid == 'z3KAMbKcGFNYVWH2OKHtz4AT1rs2');
      allow list: if isAdmin();
      allow create: if systemAdminIdentity()
        && uid == 'z3KAMbKcGFNYVWH2OKHtz4AT1rs2'
        && request.resource.data.uid == uid
        && request.resource.data.email == 'admin@vertixtrades.com'
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true;
      allow update, delete: if false;
    }

    match /signals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /marketAssets/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && id == request.resource.data.symbol && validMarketAsset(request.resource.data);
      allow delete: if isAdmin();
    }
    match /copyStrategies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /digitalAssets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /marketCalendar/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /fundingMethods/{id} {
      allow read: if verified() || isAdmin() || systemAdminIdentity();
      allow create, update, delete: if isAdmin();
    }
    match /platformSettings/{id} {
      allow read: if verified() || isAdmin() || systemAdminIdentity();
      allow create, update, delete: if isAdmin();
    }
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
